#!/bin/sh
# DSM service control for Midgar.
PID_FILE="$SYNOPKG_PKGVAR/midgar-service.pid"
RUN="$SYNOPKG_PKGDEST/midgar-run.sh"
APP_PID_FILE="$SYNOPKG_PKGVAR/midgar-app.pid"

is_running() {
	[ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

case "$1" in
	start)
		is_running && exit 0
		# .NET uses ICU for dates and languages when DSM has it. Without ICU it runs
		# in invariant mode, which must still accept "en-US".
		if ! ls /usr/lib/libicuuc.so* /lib/libicuuc.so* /usr/lib64/libicuuc.so* >/dev/null 2>&1; then
			export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
			export DOTNET_SYSTEM_GLOBALIZATION_PREDEFINED_CULTURES_ONLY=false
		fi
		export HOME="$SYNOPKG_PKGVAR"
		# midgar-run.sh runs Midgar and swaps in its self-updates.
		nohup /bin/sh "$RUN" "$SYNOPKG_PKGVAR" "$SYNOPKG_PKGDEST" >> "$SYNOPKG_PKGVAR/service.out" 2>&1 < /dev/null &
		echo $! > "$PID_FILE"
		i=0
		while [ $i -lt 20 ]; do
			is_running && exit 0
			sleep 0.25
			i=$((i + 1))
		done
		exit 1
		;;
	stop)
		if is_running; then
			PID="$(cat "$PID_FILE")"
			kill -TERM "$PID" 2>/dev/null
			i=0
			while [ $i -lt 60 ] && kill -0 "$PID" 2>/dev/null; do
				sleep 0.25
				i=$((i + 1))
			done
			kill -KILL "$PID" 2>/dev/null
		fi
		# Midgar itself, if the run script was killed before it could stop it.
		if [ -f "$APP_PID_FILE" ]; then
			kill -KILL "$(cat "$APP_PID_FILE")" 2>/dev/null
		fi
		rm -f "$PID_FILE" "$APP_PID_FILE"
		exit 0
		;;
	status)
		is_running && exit 0
		exit 3
		;;
	log)
		echo "$SYNOPKG_PKGVAR/logs/midgar.txt"
		exit 0
		;;
esac
exit 0
